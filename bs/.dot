    "node13" -> "node1" [ style = dotted ] // JPEGReadWriter2Plugin -> PharoVMCore
    "node14" [ label = "JPEGReaderPlugin", shape = doubleoctagon ];
    "node14" -> "node1" [ style = dotted ] // JPEGReaderPlugin -> PharoVMCore
